; Host-only native migration scaffold. Hardware/framework access is incomplete.
(type hibreak_eink)
(roletype r hibreak_eink)
(typeattributeset domain (hibreak_eink))
(typeattributeset coredomain (hibreak_eink))
; The priv_app client has MLS categories; the init daemon runs at s0.
(typeattributeset mlstrustedsubject (hibreak_eink))
(type hibreak_eink_exec)
(roletype object_r hibreak_eink_exec)
(typeattributeset file_type (hibreak_eink_exec))
(typeattributeset exec_type (hibreak_eink_exec))
(typeattributeset system_file_type (hibreak_eink_exec))
(allow init hibreak_eink_exec (file (read getattr map execute open)))
(allow init hibreak_eink (process (transition)))
(allow hibreak_eink hibreak_eink_exec (file (read getattr map execute open entrypoint)))
(typetransition init hibreak_eink_exec process hibreak_eink)
(allow hibreak_eink init (process (sigchld)))
(allow hibreak_eink self (process (fork)))
(allow hibreak_eink self (unix_stream_socket (create bind listen accept read write getattr getopt setopt shutdown)))
(allow priv_app hibreak_eink (unix_stream_socket (connectto)))
(allow hibreak_eink input_device (dir (search read open getattr)))
(allow hibreak_eink input_device (chr_file (read open getattr ioctl)))
; EVIOCGNAME(80), EVIOCSCLOCKID. No key injection or device grab ioctl.
(allowx hibreak_eink input_device (ioctl chr_file (0x4506 0x45a0)))
(allow hibreak_eink shell_exec (file (read open getattr map execute execute_no_trans)))
(allow hibreak_eink zygote_exec (file (read open getattr map execute execute_no_trans)))
; The current GSI's am/input/settings wrappers invoke /system/bin/cmd.
(allow hibreak_eink system_file (file (read open getattr map execute execute_no_trans)))
(allow hibreak_eink toolbox_exec (file (read open getattr map execute execute_no_trans)))
(allow hibreak_eink binder_device (chr_file (read write open getattr ioctl map)))
(allow hibreak_eink servicemanager (binder (call transfer)))
(allow hibreak_eink system_server (binder (call transfer)))
(allow hibreak_eink system_server (fd (use)))
(allow hibreak_eink activity_service (service_manager (find)))
(allow hibreak_eink input_service (service_manager (find)))
(allow hibreak_eink settings_service (service_manager (find)))
(type hibreak_eink_control_prop)
(roletype object_r hibreak_eink_control_prop)
(typeattributeset property_type (hibreak_eink_control_prop))
(typeattributeset system_property_type (hibreak_eink_control_prop))
(typeattributeset system_internal_property_type (hibreak_eink_control_prop))
(allow hibreak_eink hibreak_eink_control_prop (property_service (set)))
(allow hibreak_eink hibreak_eink_control_prop (file (read open getattr map)))
(allow hibreak_eink property_socket (sock_file (write)))
(allow hibreak_eink init (unix_stream_socket (connectto)))
