; Experimental init-only hardware bridge; does not migrate the daemon domain.
(type hibreak_eink_bridge_prop)
(roletype object_r hibreak_eink_bridge_prop)
(typeattributeset property_type (hibreak_eink_bridge_prop))
(typeattributeset system_property_type (hibreak_eink_bridge_prop))
(typeattributeset system_internal_property_type (hibreak_eink_bridge_prop))
(allow phhsu_daemon hibreak_eink_bridge_prop (property_service (set)))
(allow phhsu_daemon property_socket (sock_file (write)))
(allow phhsu_daemon init (unix_stream_socket (connectto)))
(type hibreak_eink_bridge_debugfs)
(roletype object_r hibreak_eink_bridge_debugfs)
(typeattributeset fs_type (hibreak_eink_bridge_debugfs))
(typeattributeset debugfs_type (hibreak_eink_bridge_debugfs))
(genfscon debugfs "/eink_debug/clean_a2" (u object_r hibreak_eink_bridge_debugfs ((s0) (s0))))
(genfscon debugfs "/eink_debug/anti_flicker" (u object_r hibreak_eink_bridge_debugfs ((s0) (s0))))
(allow init hibreak_eink_bridge_debugfs (file (open write)))
