; Experimental enforcing domain for the existing HiBreak display/AOD helpers.
(type hibreak_display)
(roletype r hibreak_display)
(typeattributeset domain (hibreak_display))
(typeattributeset coredomain (hibreak_display))
(allow init hibreak_display (process (transition)))
(allow hibreak_display shell_exec (file (read open getattr map execute entrypoint execute_no_trans)))
(allow hibreak_display system_file (file (read open getattr map execute execute_no_trans)))
(allow hibreak_display toolbox_exec (file (read open getattr map execute execute_no_trans)))
(allow hibreak_display self (process (fork)))
(allow hibreak_display init (process (sigchld)))
(allow hibreak_display binder_device (chr_file (read write open getattr ioctl map)))
(allow hibreak_display servicemanager (binder (call transfer)))
(allow hibreak_display system_server (binder (call transfer)))
(allow system_server hibreak_display (binder (call)))
(allow hibreak_display system_server (fd (use)))
(allow hibreak_display surfaceflinger (binder (call transfer)))
(allow hibreak_display surfaceflinger_service (service_manager (find)))
(allow hibreak_display input_service (service_manager (find)))
(allow hibreak_display settings_service (service_manager (find)))
(allow hibreak_display overlay_service (service_manager (find)))
(type hibreak_display_state_prop)
(roletype object_r hibreak_display_state_prop)
(typeattributeset property_type (hibreak_display_state_prop))
(typeattributeset system_property_type (hibreak_display_state_prop))
(typeattributeset system_internal_property_type (hibreak_display_state_prop))
(allow hibreak_display hibreak_display_state_prop (property_service (set)))
(allow hibreak_display hibreak_display_state_prop (file (read open getattr map)))
(allow hibreak_display property_socket (sock_file (write)))
(allow hibreak_display init (unix_stream_socket (connectto)))
