(type hibreak_ir_remote)
(roletype r hibreak_ir_remote)
(typeattributeset domain (hibreak_ir_remote))
(typeattributeset coredomain (hibreak_ir_remote))
(typeattributeset appdomain (hibreak_ir_remote))
(typetransition hibreak_ir_remote tmpfs file appdomain_tmpfs)
(allow hibreak_ir_remote appdomain_tmpfs (file (ioctl read write getattr relabelfrom map execute)))
(allowx hibreak_ir_remote appdomain_tmpfs (ioctl file ((range 0x7701 0x770b))))
(type hibreak_ir_remote_userfaultfd)
(roletype object_r hibreak_ir_remote_userfaultfd)
(typetransition hibreak_ir_remote hibreak_ir_remote anon_inode "[userfaultfd]" hibreak_ir_remote_userfaultfd)
(allow hibreak_ir_remote hibreak_ir_remote_userfaultfd (anon_inode (ioctl read create)))
(allow hibreak_ir_remote app_api_service (service_manager (find)))
(allow hibreak_ir_remote privapp_data_file (file (execute)))
(allow hibreak_ir_remote privapp_data_file (lnk_file (ioctl read write create getattr setattr lock append map unlink rename open watch watch_reads)))
(allow hibreak_ir_remote system_linker_exec (file (execute_no_trans)))
(type hibreak_ir_request_prop)
(roletype object_r hibreak_ir_request_prop)
(typeattributeset property_type (hibreak_ir_request_prop))
(typeattributeset system_property_type (hibreak_ir_request_prop))
(typeattributeset system_restricted_property_type (hibreak_ir_request_prop))
(type hibreak_ir_result_prop)
(roletype object_r hibreak_ir_result_prop)
(typeattributeset property_type (hibreak_ir_result_prop))
(typeattributeset system_property_type (hibreak_ir_result_prop))
(typeattributeset system_restricted_property_type (hibreak_ir_result_prop))

(allow hibreak_ir_remote property_socket (sock_file (write)))
(allow hibreak_ir_remote init (unix_stream_socket (connectto)))
(allow hibreak_ir_remote hibreak_ir_request_prop (property_service (set)))
(allow hibreak_ir_remote hibreak_ir_request_prop (file (read getattr map open)))
(allow hibreak_ir_remote hibreak_ir_result_prop (file (read getattr map open)))
(allow hibreak_ir_capture property_socket (sock_file (write)))
(allow hibreak_ir_capture init (unix_stream_socket (connectto)))
(allow hibreak_ir_capture hibreak_ir_result_prop (property_service (set)))
(allow hibreak_ir_capture hibreak_ir_result_prop (file (read getattr map open)))
(allow init hibreak_ir_request_prop (file (read getattr map open)))
(allow shell hibreak_ir_request_prop (file (read getattr map open)))
(allow shell hibreak_ir_result_prop (file (read getattr map open)))
