<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/menu_background"
    android:clipToOutline="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/linear_layout_top"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_gravity="center">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/settings_icon"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:padding="12dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/title_activity_settings"
                app:tint="?attr/colorOnSurfaceVariant"
                android:src="@drawable/baseline_settings_24" />

            <TextView
                android:layout_weight="1"
                android:id="@+id/refresh_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:gravity="center"
                android:textAlignment="center"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                android:text="@string/refresh_mode" />

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/close_menu"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:padding="12dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/close_overlay"
                app:tint="?attr/colorOnSurfaceVariant"
                android:src="@drawable/baseline_close_24" />
            </LinearLayout>

        <LinearLayout
            android:id="@+id/linear_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:orientation="horizontal"
            android:layout_gravity="center"
            android:padding="5dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button1"
                style="@style/MenuButtonStyle"
                android:layout_weight="1"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginEnd="5dp"
                android:text="@string/hd" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button2"
                style="@style/MenuButtonStyle"
                android:layout_weight="1"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginEnd="5dp"
                android:text="@string/regal" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button3"
                style="@style/MenuButtonStyle"
                android:layout_weight="1"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginEnd="5dp"
                android:text="@string/fast" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button4"
                style="@style/MenuButtonStyle"
                android:layout_weight="1"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginEnd="5dp"
                android:text="@string/extreme" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button5"
                style="@style/MenuButtonStyle"
                android:layout_weight="1"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:text="@string/hyper" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/frontlight_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/frontlight_controls"
                android:textAlignment="center"
                android:textAppearance="?attr/textAppearanceTitleMedium" />

            <LinearLayout
                android:id="@+id/light_seekbar_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:orientation="horizontal"
                android:padding="5dp">

                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    app:tint="?attr/colorOnSurfaceVariant"
                    android:src="@drawable/material_mode_cool_24" />

                <com.google.android.material.slider.Slider
                    android:id="@+id/light_seekbar"
                    style="@style/Widget.Material3.Slider"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="48dp"
                    android:contentDescription="@string/frontlight_cool" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/light_warm_seekbar_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:orientation="horizontal"
                android:padding="5dp">

                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    app:tint="?attr/colorOnSurfaceVariant"
                    android:src="@drawable/material_sunny_24" />

                <com.google.android.material.slider.Slider
                    android:id="@+id/light_warm_seekbar"
                    style="@style/Widget.Material3.Slider"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="48dp"
                    android:contentDescription="@string/warm_frontlight" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/light_brightness_seekbar_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="5dp"
                android:visibility="gone">

                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:tint="?attr/colorOnSurfaceVariant"
                    android:src="@drawable/baseline_brightness_high_24_dark" />

                <com.google.android.material.slider.Slider
                    android:id="@+id/light_brightness_seekbar"
                    style="@style/Widget.Material3.Slider"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="48dp"
                    android:contentDescription="@string/frontlight_brightness" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/light_temperature_seekbar_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:orientation="horizontal"
                android:padding="5dp"
                android:visibility="gone">

                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/frontlight_cool"
                    app:tint="?attr/colorOnSurfaceVariant"
                    android:src="@drawable/material_mode_cool_24" />

                <com.google.android.material.slider.Slider
                    android:id="@+id/light_temperature_seekbar"
                    style="@style/Widget.Material3.Slider"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="48dp"
                    android:contentDescription="@string/frontlight_temperature" />

                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/frontlight_warm"
                    app:tint="?attr/colorOnSurfaceVariant"
                    android:src="@drawable/material_sunny_24" />
            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/additional_controls_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="5dp"
                android:text="@string/additional_controls_text"
                android:textAlignment="center"
                android:textAppearance="?attr/textAppearanceTitleMedium" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/auto_refresh"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="@string/auto_refresh" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/anti_shake"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="@string/anti_shake" />

            </LinearLayout>

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/video_optimized_refresh"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/video_refresh" />

        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
