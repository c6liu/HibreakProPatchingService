<resources>
    <style name="Theme.Ha9_comp_service" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:statusBarColor">?attr/colorSurface</item>
        <item name="android:navigationBarColor">?attr/colorSurface</item>
        <item name="android:windowLightStatusBar">?attr/isLightTheme</item>
        <item name="android:windowLightNavigationBar">?attr/isLightTheme</item>
    </style>

    <style name="Theme.Ha9_comp_service.Settings" parent="Theme.Ha9_comp_service" />

    <style name="MenuButtonStyle" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textSize">12sp</item>
        <item name="android:paddingHorizontal">4dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="backgroundTint">@color/menu_button_background</item>
        <item name="android:textColor">@color/menu_button_text</item>
    </style>
</resources>
